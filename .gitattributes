# Keep source files on LF line endings regardless of the checkout machine.
# The Mio Vite transform pipeline matches multi-line anchors with `\n`, so a CRLF
# checkout on Windows breaks `npm run build`. `eol=lf` forces LF in the working tree.
* text=auto
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.inc  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.svg  text eol=lf
*.graphql text eol=lf
