  function mioWdBlockPeople(matterId){
    const matter=matters.find(m=>String(m.id)===String(matterId));if(!matter)return []
    const choices=needToSetPeopleOptionsForEvent({matter_id:matterId,matter,matters:matter,checklist_matter:matter})
    for(const role of ['client','opposing_counsel','opposing_party','court']){
      const contact=needToSetRecipientOption({type:'withdrawal',matterId,matter},role)
      if(contact.email&&!choices.some(p=>p.email.toLowerCase()===contact.email.toLowerCase()))choices.push({key:role+'::'+contact.email.toLowerCase(),source:role,label:contact.label+' - '+contact.name,email:contact.email,personId:''})
    }
    return choices
  }
  async function mioWdBlockAttachments(context,email){
    const state=mioWithdrawalStore.getSnapshot().rows[context.matterId]?.state
    if(!state?.definition)return mioWithdrawalSendAttachmentsLegacy(context,email)
    const step=state.definition.steps.find(s=>s.id===context.stepId)
    if(!step||state.paused||state.status!=='active')throw new Error('Open an active, unpaused workflow step before sending.')
    const reason=workflowBlockReason(state,step);if(reason)throw new Error(reason)
    // Never replace an attachment silently after the preview was prepared.
    const expected=email.workflow_input_versions||[]
    for(const slotId of step.input_slots){const current=resolveWorkflowSlot(state,slotId),pinned=expected.find(v=>v.slot_id===slotId);if(!pinned||pinned.id!==current?.id)throw new Error('An input document changed. Prepare the email again and review the new attachment before sending.')}
    const chosen=mioWdBlockPeople(context.matterId).filter(p=>(state.steps[step.id].recipient_ids||[]).includes(p.key))
    if(!chosen.length)throw new Error('Choose recipients associated with this matter first.')
    const actual=outlookRecipientList([email.to,email.cc].filter(Boolean).join(';')).map(r=>r.emailAddress?.address?.toLowerCase()).filter(Boolean)
    if(!actual.length||actual.some(address=>!chosen.some(p=>p.email.toLowerCase()===address)))throw new Error('Recipients changed. Review and save the intended people on this step before sending.')
    if(step.id==='closeout_email'){const t=state.steps[step.id];if(!t.links_verified||!['invoices','efilings','documents'].every(k=>/^https:\/\/[^\s]+$/.test(t.client_links?.[k]||'')&&String(email.body||'').includes(t.client_links[k])))throw new Error('Review all three client-accessible resource links and include them in this message before sending.')}
    if(step.action==='esign_document'){
      const link=state.steps[step.id].signature_url||''
      if(!/^https:\/\/[^\s]+$/.test(link)||!String(email.body||'').includes(link))throw new Error('Include the reviewed signing-provider invitation link. No signing link has been generated by Mio.')
    }
    const versions=step.input_slots.map(slot=>resolveWorkflowSlot(state,slot)),attachments=[]
    let total=0
    for(const version of versions){
      if(attachments.some(a=>a.mio_document_id===version.document_id))continue
      const doc=documents.find(d=>String(d.id)===version.document_id&&String(d.matter_id)===String(context.matterId))
      if(!doc)throw new Error('A selected input document is missing from this matter.')
      const dataUrl=await loadDocumentFileDataUrl(doc),match=String(dataUrl||'').match(/^data:([^;,]+);base64,([A-Za-z0-9+/=\r\n]+)$/)
      if(!match)throw new Error('The selected attachment could not be loaded. Nothing was sent.')
      total+=match[2].length;if(total>=4*1024*1024)throw new Error('These attachments exceed the inline email size limit. Use Outlook for the approved package and record the result; nothing was sent here.')
      attachments.push({'@odata.type':'#microsoft.graph.fileAttachment',name:doc.file_name||doc.name||'Document',contentType:match[1],contentBytes:match[2].replace(/[\r\n]/g,''),mio_document_id:version.document_id})
    }
    return attachments.map(({mio_document_id,...attachment})=>attachment)
  }
  async function mioWdBlockAction(matterId,step,state){
    const matter=matters.find(m=>String(m.id)===String(matterId));if(!matter||!state?.definition)throw new Error('Open an editable withdrawal process first.')
    if(state.status!=='active'||state.paused)throw new Error('Resume this active workflow first.')
    if(step.openExisting){openSettingWorkspace({...mioWithdrawalEmailContext(matterId,step.id),stepName:step.name,step});return}
    const reason=workflowBlockReason(state,step);if(reason)throw new Error(reason)
    const current=state.steps[step.id],inputs=step.input_slots.map(slot_id=>({slot_id,...resolveWorkflowSlot(state,slot_id)}))
    await mioWithdrawalStore.apply(session.user.id,String(matterId),{type:'module_opened',step_id:step.id,input_versions:inputs})
    setMioWdFocusMatter(String(matterId))
    if(step.action==='draft_document'){
      return mioOpenWithdrawalModule(matterId,{...step,module:'drafting',autoGenerate:true,template_id:current.template_id||step.template_id},state)
    }
    if(step.action==='efile_document'){
      if(!inputs.length)throw new Error('Assign an input document slot to this e-filing step.')
      if(efileAgentDraft?.matter_id&&!window.confirm('Prepare a withdrawal filing package? The existing unsent filing draft will be replaced. Nothing is submitted now.'))return
      const draft=defaultMioEfileDraft(),filings=[],staged=[]
      for(const input of inputs){
        const doc=documents.find(d=>String(d.id)===input.document_id&&String(d.matter_id)===String(matterId))
        if(!doc||!(/\.pdf$/i.test(doc.file_name||doc.name||'')||doc.file_type==='application/pdf'))throw new Error('E-filing requires a reviewed PDF. Save the Word draft as a PDF in this matter Documents, then attach that PDF as the current input-slot version.')
        const dataUrl=await loadDocumentFileDataUrl(doc),bytes=dataUrlToUint8Array(dataUrl||'')
        if(!bytes?.length||bytes.length>50*1024*1024||String.fromCharCode(...bytes.slice(0,5))!=='%PDF-')throw new Error('The selected filing is not a readable PDF within the size limit. Nothing was staged.')
        const id=mioEfileAgentId('efile-document'),file=new File([bytes],doc.file_name||doc.name,{type:'application/pdf'})
        staged.push([id,file]);filings.push({...draft.filings[0],id:mioEfileAgentId('filing'),description:state.definition.slots.find(s=>s.id===input.slot_id)?.name||step.name,documents:[{id,file_name:file.name,size:file.size,type:file.type,role:'lead',local_file_required:true}]})
      }
      staged.forEach(([id,file])=>{efileAgentFileObjectsRef.current[id]=file})
      setEfileAgentDraft({...draft,matter_id:matterId,cause_number:matter.cause_number||'',case_style:matter.name||'',court_name:matter.courts?.court_name||'',withdrawal_step_id:step.id,filings})
      setEfileAgentSelectedJobId('');setEfileAgentMessage('Workflow input PDFs connected. Review filing location, filing codes, service contacts and fees. Final submission still requires authorization. Put each actual file-stamped result in this step\'s output slot when received.');setPage('efile');return
    }
    if(['draft_email','esign_document'].includes(step.action)){
      const people=mioWdBlockPeople(matterId),chosen=people.filter(p=>(current.recipient_ids||[]).includes(p.key))
      if(!chosen.length)throw new Error('Choose the recipients from this matter in Choose people / message, then prepare the email.')
      if(step.action==='esign_document'&&!/^https:\/\/[^\s]+$/.test(current.signature_url||''))throw new Error('Provide an actual signing-provider request link in Choose people / message. Mio will prepare the invitation, but no signature provider is connected by this action alone.')
      const context={...mioWithdrawalEmailContext(matterId,step.id),stepName:step.name,step},workspace=normalizeWorkspace(context)
      if(workspace.emails?.length){
        const relevant=workspace.emails.filter(e=>chosen.some(p=>p.email.toLowerCase()===String(e.to||'').toLowerCase()))
        if(relevant.length!==chosen.length)throw new Error('This step already has linked emails for different recipients. Open linked email to review/remove old drafts before preparing a replacement; no messages were changed.')
        if(!window.confirm('Use the selected document versions with the existing linked emails? Review the existing wording, recipients and attachments before sending. Nothing is sent now.'))return
        relevant.forEach(e=>patchWorkspaceEmail(context,e.id,{workflow_input_versions:inputs}))
        openSettingWorkspace(context);return
      }
      const names=step.input_slots.map(id=>state.definition.slots.find(s=>s.id===id)?.name).filter(Boolean).join(', ')
      const body=current.email_body|| (step.action==='esign_document'?'Please review and sign the document using this invitation:\n\n'+current.signature_url+'\n\nPlease let me know if you have any questions.':step.id==='setting'?'Please provide available dates for a hearing or submission on the motion to withdraw in '+matter.name+'.\n\nPlease let me know any scheduling requirements.':step.id==='closeout_email'?'Attached is the signed withdrawal order. Your case materials are available at the following links:\n\nInvoices: '+(current.client_links?.invoices||'[Add invoices link]')+'\nE-filings: '+(current.client_links?.efilings||'[Add e-filings link]')+'\nCase documents: '+(current.client_links?.documents||'[Add documents link]'):'Please review '+(names?'the attached '+names:'the documents for '+matter.name)+'.\n\n'+(step.id==='agreed_submission'?'The agreed withdrawal order is submitted for the Court\'s consideration.':'Please let me know your response or any questions.'))
      for(const person of chosen){const email=createWorkspaceEmailRecord(context,context,person.source,{role:person.source,label:person.label,name:person.label,email:person.email});patchWorkspaceEmail(context,email.id,{subject:current.email_subject||step.name+' - '+matter.name,body,workflow_input_versions:inputs,send_collapsed:false,compose_mode:'new'})}
      openSettingWorkspace(context);return
    }
    if(step.action==='matter_status'){
      const field=step.target_field,value=step.target_value
      if(!['matter_status','case_status'].includes(field)||!options(field).some(o=>o.name===value))throw new Error('Choose a valid target from Settings in this step\'s definition.')
      if(!window.confirm('Change '+field.replace('_',' ')+' for '+matter.name+' to '+value+'?'))return
      if(matter[field]!==value){let query=supabase.from('matters').update({[field]:value}).eq('id',matterId);query=matter[field]==null?query.is(field,null):query.eq(field,matter[field]);const{data,error}=await query.select('id,'+field).single();if(error||data?.[field]!==value)throw new Error(error?.message||'The matter changed in another window. Reload before retrying.');await fetchMatters()}
      await mioWithdrawalStore.apply(session.user.id,String(matterId),{type:'step_update',step_id:step.id,status:'complete',confirmed:true,status_write_confirmed:true,note:'Attorney approved '+value+'. Supabase acknowledged the actual matter update.',evidence:{reference:'matters/'+matterId+'/'+field}});return
    }
    setSelectedTemplateMatterId(matterId);setPage(step.action==='calendar'?'need_to_set':'documents')
  }
